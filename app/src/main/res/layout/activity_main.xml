<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="match_parent"
    android:background="#0b0f14" android:orientation="vertical" android:padding="8dp">

    <TextView android:id="@+id/tvHp" android:layout_width="match_parent"
        android:layout_height="wrap_content" android:fontFamily="monospace"
        android:text="♥ 32/32" android:textColor="#66bb6a" android:textSize="14sp" android:textStyle="bold" />

    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal">
        <TextView android:id="@+id/tvDepth" android:layout_width="0dp" android:layout_height="wrap_content"
            android:layout_weight="1" android:fontFamily="monospace" android:text="Depth 1"
            android:textColor="#ffd54f" android:textSize="12sp" />
        <TextView android:id="@+id/tvHero" android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:fontFamily="monospace" android:text="Lv1" android:textColor="#90a4ae" android:textSize="12sp" />
    </LinearLayout>

    <FrameLayout android:layout_width="match_parent" android:layout_height="0dp"
        android:layout_weight="1" android:layout_marginTop="4dp" android:layout_marginBottom="4dp" android:background="#05070a">
        <com.example.roguelikeai.ui.GameView android:id="@+id/gameView"
            android:layout_width="match_parent" android:layout_height="match_parent" />
    </FrameLayout>

    <TextView android:id="@+id/tvRuns" android:layout_width="match_parent" android:layout_height="wrap_content"
        android:fontFamily="monospace" android:text="Run 1" android:textColor="#4dd0e1" android:textSize="11sp" />

    <ScrollView android:id="@+id/scrollLog" android:layout_width="match_parent" android:layout_height="96dp"
        android:layout_marginTop="4dp" android:background="#10161d" android:padding="6dp">
        <TextView android:id="@+id/tvLog" android:layout_width="match_parent" android:layout_height="wrap_content"
            android:fontFamily="monospace" android:textColor="#b0bec5" android:textSize="11sp" />
    </ScrollView>

    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
        android:layout_marginTop="6dp" android:orientation="horizontal">
        <Button android:id="@+id/btnPlay" android:layout_width="0dp" android:layout_height="match_parent"
            android:layout_weight="1" android:minHeight="42dp" android:text="⏸" />
        <Button android:id="@+id/btnNew" android:layout_width="0dp" android:layout_height="match_parent"
            android:layout_weight="1" android:minHeight="42dp" android:text="🔄" />
        <Button android:id="@+id/btnManual" android:layout_width="0dp" android:layout_height="match_parent"
            android:layout_weight="1.4" android:minHeight="42dp" android:text="🎮 Take over" />
        <Button android:id="@+id/btnMap" android:layout_width="0dp" android:layout_height="match_parent"
            android:layout_weight="1.2" android:minHeight="42dp" android:text="🗺 Reveal" />
    </LinearLayout>

    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
        android:orientation="horizontal">
        <Button android:id="@+id/btnLore" android:layout_width="0dp" android:layout_height="match_parent"
            android:layout_weight="1" android:minHeight="40dp" android:text="📖" />
        <Button android:id="@+id/btnRivals" android:layout_width="0dp" android:layout_height="match_parent"
            android:layout_weight="1" android:minHeight="40dp" android:text="🎯" />
        <Button android:id="@+id/btnEndless" android:layout_width="0dp" android:layout_height="match_parent"
            android:layout_weight="1.4" android:minHeight="40dp" android:text="♾ Endless" />
        <SeekBar android:id="@+id/speedBar" android:layout_width="0dp" android:layout_height="wrap_content"
            android:layout_weight="1.6" />
        <TextView android:id="@+id/tvSpeed" android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:fontFamily="monospace" android:text="8 t/s" android:textColor="#90a4ae" android:textSize="12sp" />
    </LinearLayout>

    <Spinner android:id="@+id/spinAgent" android:layout_width="match_parent"
        android:layout_height="wrap_content" android:layout_marginTop="2dp" />
</LinearLayout>
